@@ -2,9 +2,11 @@ const API_URL = process.env.NEXT_PUBLIC_API_URL || "http://localhost:4000/api";
 
 export class ApiError extends Error {
   status: number;
-  constructor(message: string, status: number) {
+  issues?: { path: string; message: string }[];
+  constructor(message: string, status: number, issues?: { path: string; message: string }[]) {
     super(message);
     this.status = status;
+    this.issues = issues;
   }
 }
 
@@ -37,7 +39,7 @@ async function request<T>(path: string, options: RequestInit = {}, retry = true)
 
   const body = await res.json().catch(() => ({}));
   if (!res.ok) {
-    throw new ApiError(body.message || `Request failed (${res.status})`, res.status);
+    throw new ApiError(body.message || `Request failed (${res.status})`, res.status, body.issues);
