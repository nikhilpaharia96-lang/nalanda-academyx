# Copy to apps/public-site/.env.local
#
# Leave NEXT_PUBLIC_API_URL empty to run entirely on local mock/content data
# (lib/content/*.ts) via the USE_MOCK_DATA boundary in lib/services/apiClient.ts.
# This is the default and recommended setting until the backend integration
# gaps documented in docs/PUBLIC_SITE_INTEGRATION.md are addressed.
NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_URL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
