# Copy to apps/public-site/.env.local
#
# Leave NEXT_PUBLIC_API_URL empty to run entirely on local mock/content data
# (lib/content/*.ts) via the USE_MOCK_DATA boundary in lib/services/apiClient.ts.
#
# Set it to the API's base URL (e.g. http://localhost:4000 for local dev,
# matching apps/api's default port and global "api" prefix) to make the
# "06 Upcoming Events" and "07 Latest Notices" homepage sections — and the
# /events and /notices pages — read live, admin-managed data instead. Both
# eventService.ts and noticeService.ts degrade to an empty list rather than
# throwing if the API is unreachable, so a misconfigured/offline backend
# will not crash the page.
NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_URL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
