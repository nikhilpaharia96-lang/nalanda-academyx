# Copy to apps/api/.env (and packages/database/.env for migrate/seed scripts).
# apps/web needs its own .env.local with NEXT_PUBLIC_API_URL.
# apps/public-site needs its own .env.local — see apps/public-site/.env.example.
# Never commit real secrets.

# --- Database ---------------------------------------------------------------
# Local dev: SQLite file (see docs/IMPLEMENTATION_PLAN.md for why).
# Production: a real Postgres connection string — see docs/PRODUCTION_DEPLOYMENT.md
# for required schema changes (dates/timestamps, currency columns) before
# pointing this at Postgres.
#   DATABASE_URL="postgresql://user:password@host:5432/nalanda?sslmode=require"
DATABASE_URL="file:./dev.db"

# --- Environment mode ---------------------------------------------------------
# Controls fail-closed security defaults (cookie Secure flag, error message
# redaction). Only the literal value "development" relaxes these — anything
# else, including an accidentally-unset value, defaults to production-safe.
# Set explicitly in every environment; do not rely on the default.
NODE_ENV=development

# --- Auth --------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- URLs / CORS ---------------------------------------------------------
# Local dev default (no config needed): apps/public-site on :3000, the portal
# app (apps/web) on :3002. In production, set ALLOWED_ORIGINS to a
# comma-separated list of every real frontend origin, e.g.
#   ALLOWED_ORIGINS=https://www.example.com,https://portal.example.com
ALLOWED_ORIGINS=
# Back-compat single-origin var — used only if ALLOWED_ORIGINS is unset.
WEB_URL=http://localhost:3002
API_URL=http://localhost:4000
API_PORT=4000

# Set to 1 (or an Express-compatible trust-proxy value) when the API runs
# behind any reverse proxy/load balancer (nginx, Render, Railway, Vercel,
# Cloudflare) — required for correct rate-limiting and audit-log IPs.
TRUST_PROXY=

# --- Razorpay (TEST MODE credentials from your Razorpay dashboard) ----------
# Never put live credentials in local/dev environments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Storage (Cloudflare R2 / S3-compatible) --------------------------------
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

# --- Email -------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Nalanda Academy <no-reply@example.com>"

# --- Seed (dev only) ---------------------------------------------------------
SEED_DEMO_PASSWORD=Passw0rd!Demo
# The seed script refuses to run when NODE_ENV=production unless this is
# explicitly set to "true". Leave unset in every real environment.
ALLOW_PROD_SEED=

# --- Frontend (apps/web) ------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api

